# Rust (Cargo.lock SÍ se versiona: es un crate binario)
/target
**/*.rs.bk

# --- Datos externos (no se versionan) ---
# /data/   = GTFS de Rodalies generado por scripts/prep_gtfs.sh
# /raw/    = feed GTFS nacional y fuentes crudas de terceros
# /report/ = dashboard HTML generado por el simulador
/data/
/raw/
/report/

# IDE / SO
.idea/
.vscode/
.DS_Store
Thumbs.db

# Copia de trabajo local del Godot antiguo (el backup intacto versionado vive en game/godot-original/)
/Simulador antiguo godot (para ayudar)/

# Cachés del editor Godot y temporales de Python dentro de game/ (el código SÍ se versiona)
game/**/.godot/
game/**/__pycache__/
**/*.pyc

# Fase 3: datos ADIF procesados (grandes, no versionar)
processed/

# LTV: ZIPs diarios de ADIF (datos, no versionar); conservar la carpeta
raw/ltv/*
!raw/ltv/.gitkeep

# ZIPs de datos crudos en la raíz (feed nacional, no versionar)
/fomento_transit*.zip
